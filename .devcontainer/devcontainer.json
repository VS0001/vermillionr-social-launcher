{
  "name": "Cloud Browser Codespace",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "customizations": {
    "vscode": {
      "extensions": [],
      "unextensions": [
        "github.copilot",
        "github.copilot-chat"
      ],
      "settings": {
        "workbench.auxiliaryBar.visible": false
      }
    }
  },
  "portsAttributes": {
    "6080": {
      "label": "noVNC Cloud Browser",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "forwardPorts": [6080]
}
